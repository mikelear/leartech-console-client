{
  "name": "@mikelear/leartech-console-client",
  "version": "0.0.1",
  "description": "Browser TypeScript client for leartech-console-api — opens the console WebSocket, sends user turns, consumes the streamed agent events. The TS mirror of the Go agent-core contract so the two ends cannot drift.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx src/*.test.ts",
    "lint": "eslint src --max-warnings 0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mikelear/leartech-console-client.git"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "tsx": "^4.19.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
